---
import { issue, later, milestones } from '../data/site';
---

<section class="section" id="roadmap">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Roadmap</span>
      <h2>Seven milestones to an MVP. All open for discussion.</h2>
      <p>Each milestone is a GitHub issue. Nothing has started yet, so now is the best time to shape it.</p>
    </div>

    <ol class="milestones">
      {
        milestones.map((m) => (
          <li>
            <a href={issue(m.n)}>
              <span class="id">{m.id}</span>
              <span class="title">
                {m.title}
                {m.detail && <span class="detail">{m.detail}</span>}
              </span>
              <span class="state">#{m.n} →</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="later">
      <span class="label">Later</span>
      <ul>{later.map((l) => <li>{l}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .milestones {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .milestones a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding 0.2s ease, background 0.2s ease;
  }

  .milestones a:hover {
    padding-left: 14px;
    background: var(--surface);
  }

  .id {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-text);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.2;
  }

  .detail {
    display: block;
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--muted);
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .later {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    margin-top: 36px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .later ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .later li {
    padding: 5px 12px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .milestones a {
      grid-template-columns: 44px 1fr;
    }

    .state {
      grid-column: 2;
    }
  }
</style>
