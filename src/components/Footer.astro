---
import { repo } from '../data/site';
import Mark from './Mark.astro';
---

<footer>
  <div class="wrap inner">
    <div class="brand">
      <Mark size={22} />
      <span>Orrery</span>
    </div>
    <ul>
      <li><a href={repo}>GitHub</a></li>
      <li><span class="soon">Docs <span class="planned">Coming soon</span></span></li>
      <li><a href={`${repo}/blob/main/LICENSE`}>MIT license</a></li>
    </ul>
    <p>Built by <a href="https://github.com/ForgeOrbit">ForgeOrbit</a></p>
  </div>
</footer>

<style>
  footer {
    padding-block: 40px 56px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 36px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    color: var(--text);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }

  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  p {
    margin-left: auto;
  }
</style>
